<?xml version="1.0" encoding="UTF-8"?>
<interface>
<template class="PreferencesDialog" parent="AdwPreferencesDialog">
<child>
	<object class="AdwPreferencesPage">
	<child>
		<object class="AdwPreferencesGroup">
		<property name="title" translatable="yes">View</property>
		<child>
			<object class="AdwSwitchRow" id="show_bit_rate">
			<property name="title" translatable="yes">_Show Bit Rate</property>
			<property name="use-underline">true</property>
			</object>
		</child>
		</object>
	</child>
	<child>
		<object class="AdwPreferencesGroup">
		<property name="title" translatable="yes">Behavior</property>
		<child>
			<object class="AdwSwitchRow" id="stop_on_quit">
			<property name="title" translatable="yes">Stop _Playback on Quit</property>
			<property name="use-underline">true</property>
			</object>
		</child>
		<child>
			<object class="AdwSwitchRow" id="mpris">
			<property name="title" translatable="yes">Support “_MPRIS”</property>
			<property name="subtitle" translatable="yes">Disable if “MPRIS” is supported by another client</property>
			<property name="use-underline">true</property>
			</object>
		</child>
		</object>
	</child>
	<child>
		<object class="AdwPreferencesGroup">
		<property name="title" translatable="yes">Cache</property>
		<child>
			<object class="AdwActionRow" id="cover_cache_row">
			<property name="title" translatable="yes">Cache _Remote Covers</property>
			<property name="use-underline">true</property>
			<property name="activatable-widget">cover_cache</property>
			<child type="suffix">
				<object class="GtkButton" id="cover_cache_clear_button">
				<property name="valign">center</property>
				<property name="icon-name">user-trash-symbolic</property>
				<property name="tooltip-text" translatable="yes">Delete Cache</property>
				<style>
					<class name="flat"/>
					<class name="circular"/>
					<class name="destructive-action"/>
				</style>
				</object>
			</child>
			<child type="suffix">
				<object class="GtkSwitch" id="cover_cache">
				<property name="valign">center</property>
				</object>
			</child>
			</object>
		</child>
		</object>
	</child>
	</object>
</child>
</template>
</interface>
